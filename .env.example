# FinanceSystem — production configuration template.
#
# Copy to the path the app reads in Production (default /etc/financesystem/.env,
# override with FINANCESYSTEM_ENV_FILE), fill in real values, then: chmod 600.
# Never commit the filled-in file.
#
# "__" (double underscore) is the section separator: ConnectionStrings__DefaultConnection
# binds to the "ConnectionStrings:DefaultConnection" configuration key.
# Save this file with LF line endings — a trailing CR becomes part of the value.

# PostgreSQL — Npgsql format. Quoted because the value contains ';' and '='.
ConnectionStrings__DefaultConnection="Host=;Port=5432;Database=FinanceSystem;Username=;Password="
ConnectionStrings__ReadOnlyConnection="Host=;Port=5432;Database=FinanceSystem;Username=;Password="

# JWT bearer authentication. SecretKey must be at least 32 bytes for HMAC-SHA256.
JWTTokenConfig__SecretKey=
JWTTokenConfig__Issuer=
JWTTokenConfig__Audience=

# CORS — comma-separated list of allowed origins.
Origins__AllowOrigins=

# Absolute URL the PSP redirects the user back to after a top-up.
# Validated at startup: the app will not boot unless this is an absolute URL.
PspCallbackUrls__TopUp=
