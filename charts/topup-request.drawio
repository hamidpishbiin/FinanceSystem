        <mxCell id="c4" value="POST /api/topup/request&lt;br&gt;{ amount (rial), pspCode }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_client"><mxGeometry x="65" y="455" width="210" height="70" as="geometry" /></mxCell>
