        <mxCell id="p1" value="User pays on PSP page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_psp"><mxGeometry x="45" y="130" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="p2" value="PSP sends browser back&lt;br&gt;(form POST: State, Status, ResNum,&lt;br&gt;RefNum, Token, Amount)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="lane_psp"><mxGeometry x="20" y="215" width="220" height="80" as="geometry" /></mxCell>
