        <mxCell id="c1" value="User logs in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_client"><mxGeometry x="105" y="130" width="130" height="60" as="geometry" /></mxCell>
        <mxCell id="c2" value="User selects top-up amount&lt;br&gt;(toman)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_client"><mxGeometry x="95" y="210" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="cp" value="User selects PSP&lt;br&gt;(e.g. Saman / BehPardakht)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lane_client"><mxGeometry x="95" y="290" width="150" height="60" as="geometry" /></mxCell>
