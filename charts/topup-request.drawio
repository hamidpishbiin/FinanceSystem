        <mxCell id="lane_db" value="Database" style="swimlane;horizontal=1;startSize=40;html=1;fillColor=#d5e8d4;swimlaneFillColor=#f3f9f3;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="0" width="260" height="2180" as="geometry" /></mxCell>
