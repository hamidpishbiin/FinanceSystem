        <mxCell id="title" value="&lt;b&gt;Top-up callback&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="-50" width="400" height="40" as="geometry" /></mxCell>
        <mxCell id="lane_client" value="User's browser" style="swimlane;horizontal=1;startSize=40;html=1;fillColor=#e1d5e7;swimlaneFillColor=#f8f3fa;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="300" height="2180" as="geometry" /></mxCell>
