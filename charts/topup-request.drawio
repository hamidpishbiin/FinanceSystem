  <diagram id="topup-callback" name="Top-up callback">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1560" pageHeight="2470" math="0" shadow="0">
      <root>
