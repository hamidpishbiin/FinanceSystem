tryDy=0;" edge="1" parent="1" source="app" target="dom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="Contracts → Core  ⚠" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;fontColor=#000000;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.0476;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="itf" target="inf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="Persistance → ReadModel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontColor=#000000;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.1786;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="inf" target="itf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="Psp, Saman, BehPardakht" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontColor=#000000;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="inf" target="app"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="Persistance, Security, PSPs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontColor=#000000;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.881;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="inf" target="dom"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="notes" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;• Arrow A → B: project A references project B (A depends on B).&lt;br&gt;• Domain depends only on Shared: the core knows nothing about the layers around it.&lt;br&gt;• Infrastructure arrows point inward: Persistance implements the repository interfaces declared in Domain and Interface.ReadModel (dependency inversion).&lt;br&gt;• Bootstrap is the composition root: it references every project so it can register them in Autofac. Host references only Bootstrap and Shared, and reaches the rest transitively. Bootstrap’s arrows to the other layers are not drawn.&lt;br&gt;• &lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;⚠&lt;/b&gt;&lt;/font&gt; Interface.Contracts → Infrastructure/Core is the one inner-to-outer reference (for HasPermission / Permissions)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontColor=#000000;align=left;verticalAlign=top;spacing=10;fontSize=12;arcSize=3;" vertex="1" parent="1"><mxGeometry x="200" y="800" width="1000" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="projects" name="Project references"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1590" pageHeight="2883" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;FinanceSystem — project references by layer&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontColor=#000000;align=left;verticalAlign=top;fontSize=18;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Host&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=15;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="760" height="625" as="geometry"/></mxCell><mxCell id="c2" value="Host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=12;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=4;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="176" width=